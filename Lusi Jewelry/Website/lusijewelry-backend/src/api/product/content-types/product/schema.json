{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Jewelry products"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title_hy": {
      "type": "string",
      "required": true
    },
    "title_en": {
      "type": "string",
      "required": true
    },
    "title_ru": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title_en",
      "required": true
    },
    "short_desc_hy": {
      "type": "text"
    },
    "short_desc_en": {
      "type": "text"
    },
    "short_desc_ru": {
      "type": "text"
    },
    "full_desc_hy": {
      "type": "richtext"
    },
    "full_desc_en": {
      "type": "richtext"
    },
    "full_desc_ru": {
      "type": "richtext"
    },
    "price_amd": {
      "type": "integer",
      "min": 0
    },
    "price_on_request": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "stock_status": {
      "type": "enumeration",
      "enum": ["instock", "made_to_order", "soldout"],
      "default": "instock",
      "required": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "new_arrival": {
      "type": "boolean",
      "default": false
    },
    "metal": {
      "type": "enumeration",
      "enum": ["gold", "white_gold", "rose_gold", "silver", "platinum", "mixed"]
    },
    "purity": {
      "type": "string"
    },
    "stone": {
      "type": "enumeration",
      "enum": [
        "none",
        "diamond",
        "garnet",
        "ruby",
        "sapphire",
        "emerald",
        "pearl",
        "topaz",
        "amethyst",
        "cubic_zirconia",
        "other"
      ],
      "default": "none"
    },
    "stone_details": {
      "type": "string"
    },
    "weight_grams": {
      "type": "decimal",
      "min": 0
    },
    "gift_recipient": {
      "type": "enumeration",
      "enum": ["for_her", "for_him", "unisex", "for_child"]
    },
    "occasions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::occasion.occasion",
      "inversedBy": "products"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    }
  }
}
