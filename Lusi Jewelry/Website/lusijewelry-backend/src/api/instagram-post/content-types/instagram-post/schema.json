{
  "kind": "collectionType",
  "collectionName": "instagram_posts",
  "info": {
    "singularName": "instagram-post",
    "pluralName": "instagram-posts",
    "displayName": "Instagram Post",
    "description": "Posts shown in the homepage Instagram section"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "required": true
    },
    "url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  }
}
