    },
    "name_en": {
      "type": "string",
      "required": true
    },
    "name_ru": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name_en",
      "required": true
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "occasions"
    }
  }
}
