{
  "kind": "collectionType",
  "collectionName": "occasions",
  "info": {
    "singularName": "occasion",
    "pluralName": "occasions",
    "displayName": "Occasion",
    "description": "Gift occasions used by the Gift Finder (wedding, birthday...)"
  },
  "options": {
