{
  "kind": "collectionType",
  "collectionName": "inquiries",
  "info": {
    "singularName": "inquiry",
    "pluralName": "inquiries",
    "displayName": "Inquiry",
    "description": "Customer inquiries and custom order requests"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email"
    },
    "preferred_contact": {
      "type": "enumeration",
      "enum": ["whatsapp", "call", "email"],
      "default": "whatsapp"
    },
    "message": {
      "type": "text"
    },
    "type": {
      "type": "enumeration",
      "enum": ["product_inquiry", "custom_order"],
      "default": "product_inquiry",
      "required": true
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    },
    "jewelry_type": {
      "type": "string"
    },
    "budget_range": {
      "type": "string"
    },
    "handled": {
      "type": "boolean",
      "default": false
    }
  }
}
